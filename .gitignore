# ---------------------------------------------------------------------------
# Secrets — NEVER commit. See docs/security.md
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kdbx
auth.json
credentials.json
service-account*.json
.netrc
.pgpass

# Hermes runtime state (contains sessions, memory, API keys)
.hermes/
hermes-home/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Private operational data (prospects, clients, briefings)
# `private/` is where `pfa leads` keeps everything. The individual names below
# are defence in depth: a prospect list saved to the repository root by hand is
# still personal data, and the mistake is easy to make once.
private/
var/
data/
logs/
*.log
briefings/
prospects.yaml
prospects.yml
prospects.csv
suppression.txt
drafts/
clients/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Node (MCP servers)
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
