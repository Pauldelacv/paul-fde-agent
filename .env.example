# ---------------------------------------------------------------------------
# Paul FDE Agent — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
#   cp .env.example .env && chmod 600 .env
#
# Every value below is a placeholder. No real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- Local model backend (Ollama, OpenAI-compatible endpoint) ---------------
# Inside Docker Compose the Ollama service is reachable as `http://ollama:11434`.
# On a bare host it is usually `http://localhost:11434`.
PFA_LOCAL_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key but the OpenAI client requires a non-empty string.
PFA_LOCAL_API_KEY=ollama

# --- Cloud model backend (optional fallback for hard reasoning tasks) -------
# Any OpenAI-compatible endpoint: OpenRouter, Anthropic, OpenAI, Nous Portal.
PFA_CLOUD_BASE_URL=https://openrouter.ai/api/v1
PFA_CLOUD_API_KEY=REPLACE_ME_WITH_YOUR_OWN_KEY

# --- Hermes runtime --------------------------------------------------------
# Where Hermes keeps config, skills, memory and sessions.
HERMES_HOME=./var/hermes

# --- FDE skill library -----------------------------------------------------
# Where this project's procedures live. Hermes loads its OWN copy from
# $HERMES_HOME/skills, so run `pfa skills install` after editing one;
# `pfa doctor` reports when the two have drifted apart.
PFA_SKILLS_DIR=./skills

# --- PostgreSQL (Phase 4 memory backend; unused in Phases 1-2) -------------
POSTGRES_USER=pfa
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_GENERATED_PASSWORD
POSTGRES_DB=pfa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Observability ---------------------------------------------------------
PFA_LOG_DIR=./var/logs
PFA_LOG_LEVEL=INFO
