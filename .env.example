# ---------------------------------------------------------------------------
# Paul FDE Agent — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
#   cp .env.example .env && chmod 600 .env
#
# Every value below is a placeholder. No real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- Local model backend (Ollama, OpenAI-compatible endpoint) ---------------
# Inside Docker Compose the Ollama service is reachable as `http://ollama:11434`.
# On a bare host it is usually `http://localhost:11434`.
PFA_LOCAL_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key but the OpenAI client requires a non-empty string.
PFA_LOCAL_API_KEY=ollama

# --- Cloud model backend (optional fallback for hard reasoning tasks) -------
# Any OpenAI-compatible endpoint: OpenRouter, Anthropic, OpenAI, Nous Portal.
PFA_CLOUD_BASE_URL=https://openrouter.ai/api/v1
PFA_CLOUD_API_KEY=REPLACE_ME_WITH_YOUR_OWN_KEY

# --- Hermes runtime --------------------------------------------------------
# Where Hermes keeps config, skills, memory and sessions.
HERMES_HOME=./var/hermes

# --- MCP connectors --------------------------------------------------------
# Declared in config/mcp.yaml and rendered into $HERMES_HOME/config.yaml.
# `pfa mcp` lists them and says which of these variables are missing.
#
# IMPORTANT: Hermes keeps an unset ${VAR} verbatim and only logs a warning, so a
# connector with no key here does not fail to start — it authenticates with the
# literal text "${LEMLIST_API_KEY}" and comes back 401, which reads like a
# revoked key. If you are not using a connector, disable it in config/mcp.yaml
# rather than leaving its variable blank.

# lemlist — prospect sourcing, email finding and verification.
# Generate one in lemlist under Settings > Integrations. It is shown once.
LEMLIST_API_KEY=REPLACE_ME_WITH_YOUR_LEMLIST_API_KEY

# Root directory the filesystem MCP server is allowed to touch. Scope it
# narrowly: this server is a file API, and pointing it at / is a shell.
PFA_WORKSPACE_DIR=./var/workspace

# --- Lead generation -------------------------------------------------------
# Where prospect lists, the suppression list and generated drafts live.
# PERSONAL DATA. Gitignored, and a test asserts it stays untracked.
PFA_PRIVATE_DIR=./private

# --- FDE skill library -----------------------------------------------------
# Where this project's procedures live. `pfa hermes-config --write` points
# Hermes at this directory via `skills.external_dirs`, so it reads them in
# place and there is no copy to fall behind. `pfa doctor` verifies that the
# configured path actually resolves — Hermes skips a bad one silently.
PFA_SKILLS_DIR=./skills

# --- PostgreSQL (Phase 4 memory backend; provisioned but not yet used) -----
POSTGRES_USER=pfa
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_GENERATED_PASSWORD
POSTGRES_DB=pfa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Observability ---------------------------------------------------------
PFA_LOG_DIR=./var/logs
PFA_LOG_LEVEL=INFO
